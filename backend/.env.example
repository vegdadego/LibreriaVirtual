# Puerto donde corre el servidor de la API (se pasa a uvicorn con --port; por defecto 8000)
# PORT=8000

# Cadena de conexión a MongoDB Atlas (no la subas al repositorio)
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/virtual_library_db?retryWrites=true&w=majority

# Clave secreta para firmar tokens JWT (la misma de antes mantiene vigentes las sesiones)
JWT_SECRET=<definir-un-valor-largo-y-aleatorio>

# Opcional: DNS a usar si tu red rechaza consultas SRV (error querySrv ECONNREFUSED)
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Carga de PDF (todas opcionales; se muestran los valores por defecto)
# MAX_PDF_SIZE_MB=50
# MAX_PDF_PAGES=2000
# UPLOAD_CONCURRENCY=2
# JOB_TTL_MINUTES=60

# Lectura de PDF en paralelo (opcionales)
# PDF_WORKERS=6                # procesos que leen PDF a la vez (por defecto min(6, CPU - 1))
# PDF_PARALLEL_MIN_PAGES=120   # desde cuántas páginas un PDF se reparte entre procesos
# PDF_POOL_WARMUP=1            # 0 = no arrancar los procesos al iniciar el servidor

# Carpeta donde se guardan las portadas (por defecto backend/uploads). Ruta absoluta o relativa a backend/
# UPLOADS_DIR=uploads
