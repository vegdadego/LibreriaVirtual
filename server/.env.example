# Puerto donde corre el servidor de la API
PORT=8000

# Cadena de conexión a MongoDB Atlas (no la subas al repositorio)
MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/virtual_library_db?retryWrites=true&w=majority

# Entorno de ejecución (development | production)
NODE_ENV=development

# Clave secreta para firmar tokens JWT
JWT_SECRET=<definir-un-valor-largo-y-aleatorio>


# Opcional: DNS a usar si tu red rechaza consultas SRV (error querySrv ECONNREFUSED)
# DNS_SERVERS=1.1.1.1,8.8.8.8
