{
  "name": "frondend-biblioteca",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000",
    "server:dev": "cd backend && .venv\\Scripts\\python -m uvicorn app.main:app --port 8000 --reload",
    "server:test": "cd backend && .venv\\Scripts\\python -m pytest",
    "test:front": "node --test \"src/**/*.test.js\"",
    "seed": "cd backend && .venv\\Scripts\\python -m scripts.seed --yes",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
