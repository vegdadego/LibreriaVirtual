# URL base de tu API Backend (cuando esté lista)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Tiempo de espera para peticiones HTTP en milisegundos
VITE_API_TIMEOUT=15000

# Nombre de la aplicación
VITE_APP_TITLE=BiblioTech - Sistema de Biblioteca

# Tamaño máximo de PDF (MB) que acepta el formulario de subida; igual que MAX_PDF_SIZE_MB del backend
# VITE_MAX_PDF_MB=200
